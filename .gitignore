# Default-deny: only reviewed source and documentation are eligible.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/config/
/config/*
!/config/server.properties.example
!/scripts/
/scripts/*
!/scripts/*.ps1
!/scripts/start.bat
!/docs/
/docs/*
!/docs/*.md
!/tests/
/tests/*
!/tests/*.ps1
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml
# Defense in depth, including files under otherwise allowed directories.
*.jar
*.zip
*.log
*.dat
*.mca
*.mcr
*.db
*.sqlite*
*.key
*.pem
*.hprof
.env*
server.properties
eula.txt
ops.json
whitelist.json
usercache.json
banned-*.json
world*/
playerdata/
advancements/
stats/
logs/
crash-reports/
backups/
libraries/
mods/
.fabric/
playit*/
*.partial/
.management.lock
.restore-*/
.rollback-*/
